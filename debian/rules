#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@


SED_COMMAND='s/.*(\([^)]*\)).*/\1/p'
UPSTREAM_VERSION := $(shell sed -n $(SED_COMMAND) debian/changelog | head -1)
MAJOR := $(word 1,$(subst ., ,$(UPSTREAM_VERSION)))
MINOR := $(word 2,$(subst ., ,$(UPSTREAM_VERSION)))
MINOR2 := $(word 3,$(subst ., ,$(UPSTREAM_VERSION)))

override_dh_auto_build :
	cd src && $(MAKE) all MAJOR=$(MAJOR) MINOR=$(MINOR) MINOR2=$(MINOR2)

override_dh_auto_clean :
	cd src && $(MAKE) clean

override_dh_auto_install :
	cd src && $(MAKE) install DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr LIB=/lib MAJOR=$(MAJOR) MINOR=$(MINOR) MINOR2=$(MINOR2)

override_dh_auto_binary-arch:
	dh_install --source=$(CURDIR)/debian/tmp

.PHONY: override_dh_auto_build override_dh_auto_clean override_dh_auto_install override_dh_auto_binary-arch
