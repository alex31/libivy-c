PROJECT_NAME           = "ivy-c"
PROJECT_BRIEF          = "Public C and C++23 APIs for the Ivy bus library"
OUTPUT_DIRECTORY       = doc/doxygen

INPUT                  = src/ivy.h src/cpp/ivy.hpp src/cpp/api src/cpp/ivy_glib.hpp src/cpp/ivy_thread.hpp
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = NO
# Doxygen does not inline headers included inside a class declaration.
FILTER_PATTERNS        = *.hpp="python3 doc/doxygen_cpp_filter.py"

OPTIMIZE_OUTPUT_FOR_C  = NO
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
EXCLUDE_SYMBOLS        = ivy::detail ivy::detail::* ivy::glib::detail ivy::glib::detail::*

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

QUIET                  = NO
