PROJECT_NAME           = "ivy-c"
PROJECT_NUMBER         = "3.18"
PROJECT_BRIEF          = "Public C and C++23 APIs for the Ivy bus library"
OUTPUT_DIRECTORY       = doc/doxygen

INPUT                  = doc/api_overview.dox src/ivy.h src/timer.h src/cpp/ivy.hpp src/cpp/api src/cpp/ivy_glib.hpp src/cpp/ivy_thread.hpp
FILE_PATTERNS          = *.dox *.h *.hpp
RECURSIVE              = NO
# Doxygen does not inline headers included inside a class declaration.
FILTER_PATTERNS        = *.hpp="python3 doc/doxygen_cpp_filter.py" *.h="python3 doc/doxygen_cpp_filter.py"
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __GNUC__=1 "__attribute__(x)="

OPTIMIZE_OUTPUT_FOR_C  = NO
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
INLINE_GROUPED_CLASSES = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
EXCLUDE_SYMBOLS        = ivy::detail ivy::detail::* ivy::glib::detail ivy::glib::detail::*

JAVADOC_AUTOBRIEF      = YES
ALWAYS_DETAILED_SEC    = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_GROUP_NAMES       = NO
SUBGROUPING            = NO
LAYOUT_FILE            = doc/DoxygenLayout.xml

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
# Doxygen 1.9.x mislinks unrelated tokens to the C++ AnchoredFormat alias.
# Printed cross-references keep the PDF accurate with the distro toolchain.
PDF_HYPERLINKS         = NO
LATEX_BATCHMODE        = YES
PAPER_TYPE             = a4
GENERATE_MAN           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

QUIET                  = NO
